# InsureLens environment variables
# The app runs fully WITHOUT any of these (data is stored in the browser).
# Copy to .env.local only if you add a backend later. Never commit real secrets.

# Public app URL (optional)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Administrator account for the Administration area (demo-level, browser-only).
# Defaults: admin@insurelens.ai / Admin@123. Set both to change them.
# NEXT_PUBLIC_ADMIN_EMAIL=admin@insurelens.ai
# NEXT_PUBLIC_ADMIN_PASSWORD=Admin@123

# Optional future integrations (not used by the current code):
# NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
